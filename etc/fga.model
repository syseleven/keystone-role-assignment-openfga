model
  schema 1.1

type domain
  relations
    define can_be_admin:   [user, group#member]
    define can_be_manager: [user, group#member] or can_be_admin
    define can_be_member:  [user, group#member] or can_be_admin or can_be_manager
    define can_be_reader:  [user, group#member] or can_be_admin or can_be_manager or can_be_member

type user
  relations
    define owner: [domain]

type group
  relations
    define member: [user, group#member]
    define owner: [domain]

type project
  relations
    define owner: [domain]
    define can_be_admin:   [user, group#member]
    define can_be_manager: [user, group#member] or can_be_admin
    define can_be_member:  [user, group#member] or can_be_admin or can_be_manager
    define can_be_reader:  [user, group#member] or can_be_admin or can_be_manager or can_be_member
    define can_be_service: [system]

type system
  relations
    define can_be_admin:  [user, group#member]
    define can_be_member: [user, group#member] or can_be_admin
    define can_be_reader: [user, group#member] or can_be_admin or can_be_member
    define can_be_system: [user, group#member]

type role
  relations
    define assignee: [roleassignment#assignee]

type roleassignment
  relations
    define assignee: [user, group#member]

